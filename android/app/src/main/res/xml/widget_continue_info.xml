<?xml version="1.0" encoding="utf-8"?>
<!--
    updatePeriodMillis="0": el widget NO se refresca solo por temporizador. El
    mínimo que respeta Android son 30 minutos y despertaría el proceso sin
    necesidad. Lo actualiza la app cuando cambia el libro o el progreso, que es
    exactamente cuando hay algo nuevo que enseñar.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_continue"
    android:resizeMode="horizontal"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />

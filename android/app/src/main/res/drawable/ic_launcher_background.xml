<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del icono adaptativo: el azul profundo de SharkReader con un halo
    radial para que la aleta no quede plana sobre un color liso.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="62"
                android:centerY="32"
                android:gradientRadius="82"
                android:startColor="#1E3A5F"
                android:endColor="#0B1220" />
        </aapt:attr>
    </path>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Marca de SharkReader: aleta dorsal sobre línea de agua.

    Icono adaptativo vectorial. El lienzo es de 108x108 dp pero el sistema puede
    recortar hasta dejar solo los 72x72 dp centrales (máscaras circulares,
    squircle, etc.), así que todo el dibujo vive dentro de esa zona segura —
    entre 18 y 90 en ambos ejes.

    Vectorial a propósito: nítido en cualquier densidad y sin depender de un PNG
    de origen a 1024 px.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Aleta. Borde de ataque convexo, borde de salida cóncavo: es lo que
         distingue una aleta de un triángulo. -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M33,72
                          C41,57 53,39 67,29
                          C68,45 66,60 77,72
                          C62,67 48,67 33,72
                          Z" />

    <!-- Sombra interna: da volumen sin recurrir a un degradado. -->
    <path
        android:fillColor="#0EA5E9"
        android:pathData="M67,29
                          C68,45 66,60 77,72
                          C70,69 63,67 56,66
                          C63,55 66,42 67,29
                          Z" />

    <!-- Línea de agua. -->
    <path
        android:strokeColor="#7DD3FC"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M22,80
                          C28,76 34,76 40,80
                          C46,84 52,84 58,80
                          C64,76 70,76 76,80
                          C80,83 84,83 87,81" />
</vector>
